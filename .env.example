DEEPSEEK_API_KEY=在这里填写你的DeepSeek_API_Key
DEEPSEEK_MODEL=deepseek-v4-flash

# 阶段 6：163 邮箱同步（授权码不是邮箱登录密码）
EMAIL_SYNC_ADDRESS=你的163邮箱地址
EMAIL_SYNC_AUTH_CODE=你的163客户端授权码
EMAIL_SYNC_IMAP_HOST=imap.163.com
EMAIL_SYNC_IMAP_PORT=993
EMAIL_SYNC_SENT_FOLDER=已发送
EMAIL_SYNC_INCOMING_FOLDER=求职同步
EMAIL_SYNC_DRAFT_FOLDER=草稿箱
EMAIL_SYNC_MAX_MESSAGES=100
# 第一次使用必须保持 false，观察识别结果稳定后再考虑开启。
EMAIL_SYNC_AUTO_APPLY=false
